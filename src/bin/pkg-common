#!/usr/bin/env bash-shlib
# -*- mode: shell-script -*-


## TODO
##
## - support for btrfs snapshots if possible addtionally to clone to tmp ?
## - upgrade: with external loop to check publishing ? or localy with 'dpkg -i' ?
## - we could add a check after publish that it appears in the deb index.
## - in the line of the process release checks, it should probably check also that
##   the commit was pushed before actually releasing anything.
## - in the line of the process release checks, it should probably check also that
##   the tests passes.


[[ "${BASH_SOURCE[0]}" != "${0}" ]] && SOURCED=true

include common
include pretty
include parse
include cmdline

depends unionfs-fuse

version=0.0.1
desc="Manage test and release of packages"
usage="
$exname {-h|--help}
$exname [-c|--committed] [-w|--workdir] [-p|--publish]

General purpose options:

    -v|--verbose        Show VM processing
    -d|--debug          Show a lot of information
    --no-cache          Prevent any caching

target source selector: (default is '-c HEAD')

    -c|--committed REV   Use commit specified by REV
    -w|--workdir         Use the state of the current workdir
    --staged             Use the staged state

multi-target source selector:

    -i|--intermediate    Use each commit since last push.
    --since REV       Use each commit since given REV.

Options passed to dovis:

    -p|--platform|-V|--target-version|-f|--filter|-t|--test


Disable checks:

    --no-tests
    --no-dist
    --no-dist-check
    --no-sanity-check
    --no-cover
    --no-profile

Sub-commands:

    $exname vendor [-n|--dry-run]
                        Copy 0k-pkg's autogen.sh and the plugins'
                        autogen.d/ scripts into the project (tracked
                        in .package.d/autogen.d/MANIFEST).

Others:

    --coverage-report
    -b|--bisect
    -C|--continue-on-error
    -s|--shell
    --publish


"


[ "$SOURCED" ] && return 0


##
## Command line processing
##


# cmdline.spec.gnu
# cmdline.spec.reporting


# cmdline.spec::cmd:__main__:run() {

#     : :optfla: --no-cache         'Prevent any caching (profiling, tests, dists)'
#     # : :optfla: --coverage-report  'Only print coverage report.
#     #                                (Conflicts with --no-cover)'

#     ##
#     ## cmdline Argument parsing
#     ##

#     ## Conflict
#     # if [ -n "$opt_coverage_report" -a -n "$opt_no_cover" ]; then
#     #     die "Conflicting options: you can't use '--coverage-report'" \
#     #         "and '--no-cover' together."
#     # fi

#     DOVIS_TRANSFER_OPTFLA=(no-cache )
#     dovis_args=()
#     for opt in "${DOVIS_TRANSFER_OPTFLA[@]}"; do
#         opt="${opt//-/_}"
#         dovis_args+=("${opt_no_cache+--no-cache}")
#     done



##
## Legacy Argument parsing
##

publish=
upgrade=
no_test=
coverage_report=
no_check_dist=
# no_git_installability=
# no_installability=
check_intermediate=(HEAD)
dovis_args_breaking_cache=()
previous_args=()
no_cache=
allow_publish_off_tags=
export PKG_COVERAGE=1
export PKG_PROFILE=1
## Sub-commands: ``pkg vendor [...]`` runs the ``vendor`` verb of
## pkgcmd (the same as a ``vendor`` symlink to pkgcmd would).
case "$1" in
    vendor)
        depends pkgcmd
        . "$(which pkgcmd)" || die "Couldn't load 'pkgcmd'."
        pkg.load
        pkg.run "$1" "${@:2}"
        exit $?
        ;;
esac

while [ "$1" ]; do
    previous_args+=("$1")
    case "$1" in
        "--help"|"-h")
            print_usage
            exit 0
        ;;

        --coverage-report)
            coverage_report=1
            [ "$no_cover" ] && {
                die "Conflicting options: you can't use '$1' and ask for no coverage."
            }
            no_dist=1
            ;;


        ##
        ## Single source selection
        ##

        --staged)
            intended_source=staged
            [ -z "$source" -o "$source" == "$intended_source" ] || {
                die "Can't use $1 as a previous option already set it to '$source'."
            }
            source="$intended_source"
            ;;
        -c|--committed)
            intended_source=commit
            [ -z "$source" -o "$source" == "$intended_source" ] || {
                die "Can't use $1 as a previous option already set it to '$source'."
            }
            commit_selected="$2"
            shift
            source="$intended_source"
            ;;
        -w|--workdir)
            intended_source=workdir
            [ -z "$source" -o "$source" == "$intended_source" ] || {
                die "Can't use $1 as a previous option already set it to '$source'."
            }
            source="$intended_source"
            ;;


        ##
        ## Multiple source selection
        ##

        -i|--intermediate)
            [ "$shell" ] && {
                die "You can't use '$1' if you asked for a shell. Please be specific source wise."
            }
            intended_source=intermediate
            [ -z "$source" -o "$source" == "$intended_source" ] || {
                die "Can't use $1 as a previous option already set it to '$source'."
            }
            source="$intended_source"

            current_branch=$(git symbolic-ref HEAD 2>/dev/null) || {
                die "Couldn't get symbolic ref of current repository."
            }
            target_branch=$(git for-each-ref --format='%(upstream:short)' "$current_branch") || {
                die "Couldn't get target ref of branch '$current_branch'."
            }
            if [ -z "$target_branch" ]; then
                die "Couldn't get upstream name of current branch '$current_branch'."
            fi
            # echo "RUNNING on all these commit:"
            # git log --graph "$target_branch".."$current_branch" \
                # --pretty=tformat:%C\(yellow\ normal\)%h%Creset\ %C\(blue\ normal\)%an%Creset\ %s\ %Cgreen%d%Creset |
            # sed -r "s/^/ $GRAY|$NORMAL/g"
            check_intermediate=($(git rev-list --reverse "^$target_branch" "$current_branch")) || exit 1
            if [ "${#check_intermediate[@]}" == "0" ]; then
                warn "No commit selected, did you already push ?"
                exit 1
            fi
            ;;

        --since)
            [ "$shell" ] && {
                die "You can't use '$1' if you asked for a shell. Please be specific source wise."
            }
            intended_source=since
            [ -z "$source" -o "$source" == "$intended_source" ] || {
                die "Can't use $1 as a previous option already set it to '$source'."
            }
            source="$intended_source"

            since_commit="$2"
            check_intermediate=($(git rev-list --reverse "^$since_commit" "HEAD")) || exit 1
            shift
            ;;


        -b|--bisect)
            bisect=true
            ;;


        -p|--platform|-V|--target-version|-f|--filter|-t|--test)
            [ "$no_test" -a "$no_dist_check" ] && {
                die "You can't provide dovis args (like '$1 $2') and select --no-tests and --no-dist-check at the same time."
            }
            dovis_args+=("$1" "$2")
            dovis_args_breaking_cache+=("$1" "$2")
            shift
            ;;
        -C|--continue-on-error)
            dovis_args+=("$1")
            ;;
        -s|--shell)
            shell=yes
            [ "$source" == "intermediate" ] && {
                die "Can't use '$1' in intermediate mode. Please be more specific to identify one source."
            }
            dovis_args+=("$1")
            ;;
        -v|--verbose)
            dovis_args+=("$1")
            ;;
        -d|--debug)
            dovis_args+=("$1")
            ;;
        --no-tests)
            ## dovis is used also for dist-checks !
            # [ "${dovis_args[*]}" ] && {
            #     die "You can't provide '--no-tests' option and set dovis args (like '${dovis_args[*]}')."
            # }
            contains --test-only "${previous_args[@]}" && {
                die "Conflicting options: you can't use '$1' and --test-only together."
            }
            no_test=true
            ;;
        --test-only)
            contains --no-tests "${previous_args[@]}" && {
                die "Conflicting options: you can't use '$1' and --no-tests together."
            }
            no_test=
            no_dist=true
            no_dist_check=true
            no_sanity_check=true
            ;;
        --no-dist)
            [ "$publish" ] && {
                die "You can't provide '--no-dist' option while having '--publish' mode."
            }
            no_dist=true
            no_dist_check=true
            export PKG_DIST=
            ;;
        --no-dist-check)
            no_dist_check=true
            ;;
        --no-sanity-check)
            no_sanity_check=true
            ;;
        --no-cover)
            no_cover=true
            [ "$coverage_report" ] && {
                die "Conflicting options: you can't use '$1' and ask for coverage reports."
            }
            export PKG_COVERAGE=
            ;;
        --no-profile)
            no_profile=true
            export PKG_PROFILE=
            ;;
        --no-cache)
            no_cache=yes
            dovis_args+=("$1")
            ;;

        # --no-git-installability)
        #     no_git_installability=true
        #     ;;
        # --no-installability)
        #     no_installability=true
        #     ;;
        --publish)
            [ "$no_dist" ] && {
                die "You can't provide '--publish' option while having '--no-dist' mode."
            }
            publish=true
            ;;
        --allow-publish-off-tags)
            [ -z "$publish" ] && {
                die "You need to provide '--publish' option before using '--allow-publish-off-tags'."
            }
            [ "$no_dist" ] && {
                die "You can't provide '--publish' option while having '--no-dist' mode."
            }
            allow_publish_off_tags=true
            ;;
        *)
            err "Unexpected argument '$1'."
            exit 1
            ;;
    esac
    shift
done



CONFIG_PATH="${PKGCMD_CONFIG_PATH:-$HOME/.pkgcmd.d}"



##
# General Variables
#
#


## autogen.sh needs git anyway
if [ ! -d .git ]; then
    die "Should be a git repository. (didn't find '.git' dir)"
fi

## Every ``./autogen.sh`` run by the release pipeline (source checks,
## builds) must have its optional tools (pandoc, gitchangelog, ...)
## available: a release artifact with a half-generated README is a
## bug, whereas a developer's ``git clone && ./autogen.sh`` is not.
export AUTOGEN_STRICT=1

depends pkgcmd

if ! . "$(which pkgcmd)"; then
    err "Could'nt load 'pkgcmd'."
    exit 1
fi

pkg.load

alternatives="$(pkg._list_pkg_alternatives)" || {
    err 'Unidentified package'
    exit 1
}
export PKGCMD_ALTERNATIVES="$alternatives"


settmpdir tmpdir
settmpdir upperlayer
settmpdir workdir
settmpdir build

export tmpdir upperlayer workdir build

dovis_save="$PWD/.dovis"
mkdir -p "$dovis_save"



pkg_save="$PWD/.pkg"
mkdir -p "$pkg_save"
touch "$pkg_save/passed"

case "${source:-commit}" in
    since)
        # if [ -z "$check_intermediate" ]; then
        #     echo "${WHITE}last 5 commit:$NORMAL"
        #     git log -n 5 --graph \
        #         --pretty=tformat:%C\(yellow\ normal\)%h%Creset\ %C\(blue\ normal\)%an%Creset\ %s\ %Cgreen%d%Creset \
        #         "^$since_commit" "HEAD" |
        #         sed -r "s/^/ $GRAY|$NORMAL/g"
        # fi
        Wrap -q <<EOF || exit 1
git clone . "$tmpdir/"
cd "$tmpdir/"
git submodule update --init --recursive
EOF
        ;;
    intermediate)
        branch=$(git symbolic-ref HEAD 2>/dev/null) || {
            die "Couldn't get symbolic ref of current repository."
        }
        branch=${branch#refs/heads/}
        if [ -z "$check_intermediate" ]; then
            echo "${WHITE}current branch:$NORMAL $DARKGREEN$branch$NORMAL"
            echo "${WHITE}last 3 commit:$NORMAL"
            git log -n 3 --graph \
                --pretty=tformat:%C\(yellow\ normal\)%h%Creset\ %C\(blue\ normal\)%an%Creset\ %s\ %Cgreen%d%Creset |
                sed -r "s/^/ $GRAY|$NORMAL/g"
        fi
        Wrap -q <<EOF || exit 1
git clone -b "$branch" . "$tmpdir/"
cd "$tmpdir/"
git submodule update --init --recursive
EOF
        ;;
    commit)
        Wrap -q <<EOF || exit 1
git clone . "$tmpdir/"
cd "$tmpdir/"
git checkout "${commit_selected:-HEAD}"
git submodule update --init --recursive
EOF
        ;;
    workdir)
        Wrap -q -d "Copying to temporary directory $tmpdir" <<EOF || exit 1
tar c . | (cd "$tmpdir" ; tar xv)
EOF
        ;;
    staged)
        Wrap -d "Copying to temporary directory $tmpdir" <<EOF || exit 1
tar c . | (cd "$tmpdir" ; tar xv) &&
cd "$tmpdir/" &&
git stash save --keep-index &&
git clean -f -d -x
EOF
        ;;
    *)
        echo "Got value '${source:-workdir}' and this should not happen."
        exit 1
esac

cd "$tmpdir"


if [ "$shell" ]; then
    dovis "${dovis_args[@]}"
    exit $?
fi


##
# Get other variables
#

# Name of package is deduced from the name of the directory containing sources

set-overlay() {
    overlay-setup || exit 1
    trap_add EXIT "overlay-teardown || {
                        err \"Couldn't remove overlay on '$workdir' properly.\"
                        exit 101
                    }"

}
export -f set-overlay

overlay-setup() {
    OVERLAY_PREV_CWD="$PWD"
    ## Must edit /etc/fuse.conf to user_allow_other
    unionfs-fuse -o cow,allow_root "$upperlayer=RW:$tmpdir=RO" "$workdir"
    cd "$workdir"
}

overlay-teardown() {
    cd "$OVERLAY_PREV_CWD"
    fusermount -u "$workdir" &&
    rm -rf "$upperlayer" &&
    mkdir "$upperlayer"
}

md5() {
    md5_compat |  cut -f 1 -d " "
}


variable_get() {
    [ -r ".package" ] && . ./.package

    pkg_version=$(pkg.run pkg-version) || return 1
    pkg_version=${pkg_version//_/-}
    pkg_name=$(pkg.run pkg-name) || return 1

    is_set pkg_name
    is_set pkg_version
    # echo "${WHITE} Package${NORMAL} $pkg_name $pkg_version"

    # # Making debname
    dist_filename="$pkg_name-$pkg_version.tar.gz"
    # echo "  ${WHITE}dist package name:${NORMAL} $dist_filename"

    export pkg_name pkg_version dist_filename
}

##
## pkg functions
##

PKG_CONFIGFILE=~/.config/pkg/main.yml
pkg.load_config() {
    if ! [ -f "$PKG_CONFIGFILE" ]; then
        die "No pkg config file found in '$PKG_CONFIGFILE'."
    fi
    PKG_CONFIG="$(cat "$PKG_CONFIGFILE")"
}

pkg.config() {
    local value
    value=$(echo "$PKG_CONFIG" | shyaml "$@") || {
        die "Config file '$PKG_CONFIGFILE' incomplete or invalid."
        exit 1
    }
    echo "$value"
}


##
# FUNCTIONS
#
#


pkg_dist_check() {
    local build="$1" dist

    Section General distribution files checks

    cd "$build"
    for dist in *; do
        while read-0 script; do
            echo " ${WHITE}$script${NORMAL}"
            . "$script" || exit 1
        done < <(pkg._list_scripts release/check)
        errlvl=$?
        [ "$errlvl" == 0 ] || exit 1
    done


}


function mk_prepare_build() {
    local build="$1" dir

    Section Making distribution files

    local has_run=
    while read-0 script; do
        has_run=1
        type="${script##*/}"
        cache_file $cache_prevent_opt "$pkg_save"/builds/$type dir "make package $type" <<EOF || exit 1
        ## $pkg_version $commit_md5 $tree_hash $md5_dovis $md5_targets $no_dist_check $md5_dovis_args
        set-overlay || exit 1
        Wrap -d "make package $type" -- "$script" "\$dir" || exit 1
EOF
        ## being paranoid:
        [ -n "$dir" -a "$dir" != "/" ] || {
            die "Variable should be non-empty. Bailing out"
        }

        pkg_filename_prefix=${pkg_name//-/_}
        if [ -e "$dir/.dist-filename" ]; then
            pkg_filename_prefix=$(cat "$dir/.dist-filename")
        fi
        cp -l "$dir/${pkg_filename_prefix}"* "$build/" || exit 1
    done < <(pkg._list_scripts release/build)
    if [ -z "$has_run" ]; then
        pkg._list_scripts release/build >&2
        err "No building instructions found."
        exit 1
    fi

    if [ -x .package ]; then
        (
            set-overlay || exit 1

            unset dist_hook
            variable_get || exit 1
            if ! declare -F dist_hook >/dev/null; then
                exit 0
            fi
            dist_hook ## should place some files in $build/$pkg_version
        ) || exit 1

    fi

    # print_error "Can't recognize the current package, and can't choose a way to distribute it..."
}


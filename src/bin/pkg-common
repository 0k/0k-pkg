cache_file() {
    local code code_hash cmdline cache_dir cached_message file_var
    prevent=
    cmdline=()
    while read-0 arg; do
        case "$arg" in
            -p|--prevent) prevent=yes ;;
            "--")
                while cmdline+=("$(next-0)"); do :; done
                break
                ;;
            *) cmdline+=("$arg");;
        esac
    done < <(cla.normalize "$@")
    cache_dir="${cmdline[0]}"
    file_var="${cmdline[1]}"
    cached_message="${cmdline[2]}"

    code=$(cat -)
    code_hash=$(echo "$code" | hash_get)
    export "$file_var"="$cache_dir/$code_hash"
    ## being paranoid:
    [ "$code_hash" ] || {
        die "Empty code hash (dangerous error). Bailing out."
    }
    if [ -d "$cache_dir" -a -e "$cache_dir/$code_hash" ]; then
        if [ "$prevent" ]; then
            rm -rf "$cache_dir/$code_hash"
        else
            Elt "$cached_message"
            print_info cached
            print_status noop
            Feed
            return 0
        fi
    fi

    mkdir -p "$cache_dir/$code_hash"
    # echo "$code" | prefix "  ${GREEN}|${NORMAL} " >&2
    ( eval "$code" )
    errlvl="$?"
    if [ "$errlvl" != 0 ]; then
        rm -rf "$cache_dir/$code_hash"
        # err "Failed cache_file for '$cached_message'."
        # echo "code:" >&2
        # echo "$code" | prefix "  | " >&2
        return "$errlvl"
    fi
}


cache() {
    local code code_hash cmdline cache_file cached_message
    prevent=
    cmdline=()
    while read-0 arg; do
        case "$arg" in
            -p|--prevent) prevent=yes ;;
            "--")
                while cmdline+=("$(next-0)"); do :; done
                break
                ;;
            *) cmdline+=("$arg");;
        esac
    done < <(cla.normalize "$@")
    cache_file="${cmdline[0]}"
    cached_message="${cmdline[1]}"

    code=$(cat -)
    code_hash=$(echo "$code" | hash_get)
    if egrep ^"$code_hash"$ "$cache_file" >/dev/null 2>&1; then
        if [ "$prevent" ]; then
            sed -ri "/^$code_hash\$/d" "$cache_file"
        else
            Elt "$cached_message"
            print_info cached
            print_status noop
            Feed
            return 0
        fi
    fi

    ( eval "$code" ) || return $?
    echo "$code_hash" >> "$cache_file"
}

publish() {
    if [ "$source" == "workdir" ]; then
        die "Prevented publishing something coming from $source." \
            "(Please use -c to use what has been committed)"
    fi

    echo "${WHITE}repository location:${NORMAL} $repos_ssh_target";

    Section "Updating $repos_ssh_host PyPI repository"

    Elt "Sending to repos... "; Feed
    echo twine upload /tmp/${dist_filename}
}


test_all() {
    local rev="$1"

    echo " > $WHITE$msg" | cutline "$SIZE_LINE"
    echo

    cache_file $cache_prevent_opt "$pkg_save"/tests artifact_dir "full tests" <<EOF || return 1
        ## $other_hash $commit_md5 $tree_hash $md5_dovis $md5_targets $md5_dovis_args $md5_test_current $no_test
        ## $no_cover $description
        test_current
EOF

    if [ "$no_dist" ]; then
        return 0
    fi

    variable_get || return 1
    cache $cache_prevent_opt "$pkg_save"/dist_passed "test for dist" <<EOF || return 1
        ## $other_hash $commit_md5 $tree_hash $md5_dovis $md5_targets $no_dist_check $md5_dovis_args
        ## $description

        test_dist
EOF

    cache_file $cache_prevent_opt "$pkg_save"/builds build "builds" <<EOF || return 1
        ## $pkg_version $other_hash $commit_md5 $tree_hash $md5_dovis $md5_targets $no_dist_check $md5_dovis_args
        ## $description
        mk_prepare_build "\$build"
EOF

    cache $cache_prevent_opt "$pkg_save"/build_passed "test builds" <<EOF || return 1
        ## $pkg_version $other_hash $commit_md5 $tree_hash $md5_dovis $md5_targets $no_dist_check $md5_dovis_args
        ## $description
        test_dist_file "\$build"
EOF

}


pkg.load_config

if [ -z "$no_test" ] && ! type -p dovis >/dev/null 2>&1; then
    warn "Executable 'dovis' not found, ignoring tests."
    no_test=1
    no_dist_check=1
fi

if [ -z "$no_test" ] && ! dovis --check-runnable 2>/dev/null; then
    warn "No platform requirements found for testing by 'dovis'. Ignoring tests."
    no_test=1
    no_dist_check=1
fi

if [ -z "$no_test" ]; then
    md5_dovis=$(cat $(which dovis) | md5)
    ## YYYvlab: unspecify here !
    md5_py_versions=$(echo "$PY_VERSIONS" | md5)
    if ! targets=("$(dovis --list-targets "${dovis_args[@]}")"); then
        exit 1
    fi
    md5_targets=$(echo "${targets[*]}" | md5)
    md5_test_current=$(declare -f test_current | md5)
    md5_dovis_args=$(printf "%s\0" "${dovis_args_breaking_cache[@]}" | sort -z | md5)
fi

count="${#check_intermediate[@]}"
max_len_nb="${#count}"
format="[%${max_len_nb}d/$count]"

if [ "$count" == 0 ]; then
    echo "No commits to check !"
    exit 0
fi

i=0
for rev in "${check_intermediate[@]}"; do
    ((i++))

    #git clean -f -d -x &&
    git checkout -q "$rev" >/dev/null || exit 1
    ## autogen depends on that
    description=$(git describe HEAD --tag) || {
        err "Couldn't describe HEAD. Are there any tags in this repository ?"
        exit 1
    }

    other_hash=$(while read tag; do git log -n 1 --format="$tag:%ct" $tag ; done < <(git tag) | hash_get)
    if ! git diff --no-ext-diff --quiet --exit-code; then
        warn "testing working directory in a dirty state"
        commit_md5=
        tree_hash=
        ## YYYvlab: should add a special package value
    elif ! git diff --staged --no-ext-diff --quiet --exit-code >/dev/null 2>&1; then
        warn "testing working directory in a dirty state (staged changes only)"
        commit_md5=HEAD
        tree_hash=$(git write-tree)
    else
        commit_md5=$(git rev-parse HEAD)
        tree_hash=$(git show -q --format=%T HEAD)
    fi
    cache_prevent_opt=$([ -z "$no_cache" -a "$commit_md5" ] || echo "-p")
    msg=$(printf "$format " "$i"
        git log -n 1 "$rev" \
              --pretty=tformat:%C\(yellow\ normal\)%h%Creset\ %C\(blue\ normal\)%an%Creset\ %s )
    cache_file $cache_prevent_opt "$pkg_save"/artifacts artifacts "$msg" <<EOF || exit 1
        ## $other_hash $commit_md5 $tree_hash $md5_dovis $md5_targets $md5_dovis_args $md5_test_current
        ## $no_dist $no_cover $no_dist_check $no_test $description

    test_all "$rev" && {
      mkdir -p \$artifacts/{build,cover}
      [ "$no_dist" ] || {
           [ "\$build" -a -d "\$build" ] || {
                echo "Assert error: build variable is empty." >&2
                exit 1
           }

           cp "\$build"/* "\$artifacts/build" || true
      }
      [ "$no_test" -o "$no_cover" ] || ! [ -e ""\$artifact_dir"/coverage_report" ] || \
          cp "\$artifact_dir"/coverage_report "\$artifacts/cover" || true
    }

EOF
    if [ "$coverage_report" ]; then
        if [ -s "$artifacts/cover/coverage_report" ]; then
            echo "$artifacts/cover/coverage_report"
            echo "   - ${WHITE}Coverage report:$NORMAL"
            prev_file=
            while read file number; do
                if [ "$file" != "$prev_file" ]; then
                    echo
                    echo "File $WHITE$file$NORMAL:"
                    prev_file=$file
                fi
                echo "    "
                echo "  $GRAY..$WHITE lines$NORMAL $number:"
                echo "    "
                cat "$file" | stdin_line_with_context "$number"
            done < <(cat "$artifacts/cover/coverage_report") | sed 's/^/  | /g'
        else
            echo "   - ${WHITE}Coverage is ${GREEN}complete$NORMAL"
        fi
    fi
done

## Sending to repos

if [ -n "$publish" ]; then

    ## are we on a tag ?
    description=$(git describe HEAD --tag) || {
        err "Couldn't describe HEAD. Are there any tags in this repository ?"
        exit 1
    }
    if [ -z "$allow_publish_off_tags" ] && [[ "$(git tag -l | grep -F "$description")" != "$description" ]]; then
        die "Release are allowed only on git tags. (use \`--allow-publish-off-tags\` to force)"
    fi
    export description
    (
        overlay-setup || exit 1
        trap_add EXIT "overlay-teardown || {
            err \"Couldn't remove overlay on '$workdir' properly.\"
            exit 101
        }"
        cd "$workdir"
        variable_get || exit 1

        if [ -z "$allow_publish_off_tags" ] && [ "$description" != "$pkg_version" ]; then
            die "Release are allowed only on same name tags (current version: $pkg_version)"
        fi
        Section Publishing

        has_run=
        while read-0 script; do
            has_run=1
            "$script" || exit 1
        done < <(pkg._list_scripts release/publish)
        if [ -z "$has_run" ]; then
            err "No publish instructions found."
            exit 1
        fi


    )

#     (

#!/bin/bash

build="$1"

cd "$workdir"
mkdir -p "$build" &&
(
    if [ -x ./autogen.sh ]; then
        ./autogen.sh
    fi
) &&
{
    ## Library crates should not include Cargo.lock (downstream users
    ## resolve their own dependencies). Binary crates need it for
    ## reproducibility with `cargo install --locked`.
    pkg_opts=()
    if [ -f src/lib.rs ] && [ ! -f src/main.rs ] && ! grep -q '^\[\[bin\]\]' Cargo.toml; then
        pkg_opts+=(--exclude-lockfile)
    fi
    cargo package --allow-dirty "${pkg_opts[@]}"
} &&
mv "target/package/${pkg_name}-${pkg_version}.crate" "$build/" &&
echo "${pkg_name}-${pkg_version}" > "$build/.dist-filename"

#!/bin/bash

# cargo publish needs to run from the package directory.
# We run autogen.sh to substitute version and prepare files.
# We use --no-verify since the package was already verified during build.

cd "$workdir" || exit 1

if [ -x ./autogen.sh ]; then
    ./autogen.sh || exit 1
fi

cargo publish --no-verify --allow-dirty >&2 || exit 1

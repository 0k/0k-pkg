## -*- mode: shell-script -*-
##
## Lint every ``*.rst`` with docutils' ``rst2html`` (needs
## ``docutils``).  Sphinx-only directives and roles are ignored since
## plain docutils does not know them; every other diagnostic fails
## the check, printed as ``file:line: message``.
##

(
   set-overlay || exit 1

Wrap -d "Checking ReSTructured files" <<'EOF2' || exit 1
cd "$workdir"
./autogen.sh  ## Generates the CHANGELOG.rst

if ! command -v rst2html >/dev/null 2>&1; then
    echo "rst2html not found: install docutils (pip install docutils)." >&2
    exit 1
fi

status=0
while IFS= read -r -d '' file; do
    while IFS= read -r line; do
        case "$line" in
            *"Unknown directive"*|*"Unknown interpreted"*) continue;;
            "$file:"*|"${file#./}:"*)
                echo "!! $line" >&2
                status=1
                ;;
        esac
    done < <(rst2html "$file" 2>&1 >/dev/null)
done < <(find . -type f -name '*.rst' -not -path './.git/*' -print0)
exit $status
EOF2
) || exit 1

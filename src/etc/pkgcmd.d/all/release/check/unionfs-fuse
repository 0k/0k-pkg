## -*- mode: shell-script -*-

Wrap -d "check: '$dist' doesn't pack .unionfs-fuse" <<EOF || exit 1
    content=\$(if [[ "$dist" == *".whl" ]]; then
        unzip -l "$dist"
    elif [[ "$dist" == *".tar.gz" ]] || [[ "$dist" == *".tgz" ]]; then
        tar tvzf "$dist"
    else
        echo "Could not list content of '$dist'." >&2
        exit 1
    fi)
    if echo "\$content" | grep .unionfs-fuse >/dev/null; then
       echo "Error: .unionfs-fuse file in package." >&2
       echo "Content of package:"
       echo "\$content" | sed -url1 's/^/  /g'
       exit 1
    fi
EOF

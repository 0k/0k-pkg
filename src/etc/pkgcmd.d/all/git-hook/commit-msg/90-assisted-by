#!/bin/bash

## The password store (pass) manages its own commits; never audit them.
if [ "$PWD" == "$HOME/.data-store-shared/pass" ]; then
    exit 0
fi

msg_file="$1"

add_trailers() {
    local trailer
    while IFS= read -r trailer; do
        [ -n "$trailer" ] || continue
        git interpret-trailers --in-place \
            --if-exists addIfDifferent \
            --trailer "$trailer" \
            "$msg_file" || return 1
    done <<< "$1"
}

## ``$COMMIT_ASSISTED_BY`` names the models that actually authored the
## content (comma-separated ``Agent:model``), when they differ from the
## committing session's model.  It replaces session detection.  The
## whole value is validated before any trailer is written.
if [ -n "${COMMIT_ASSISTED_BY+set}" ]; then
    trailers=""
    IFS=',' read -r -a authors <<< "$COMMIT_ASSISTED_BY"
    [ "${#authors[@]}" -gt 0 ] || authors=("")
    for author in "${authors[@]}"; do
        author="${author#"${author%%[![:space:]]*}"}"
        author="${author%"${author##*[![:space:]]}"}"
        if ! [[ "$author" =~ ^[A-Za-z][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._/:-]*$ ]]; then
            echo "commit-msg: REJECTED" >&2
            echo "  COMMIT_ASSISTED_BY entry «$author» is not \`Agent:model\`." >&2
            echo "  Expected comma-separated \`Agent:model\` values, e.g." >&2
            echo "    COMMIT_ASSISTED_BY='Claude:claude-sonnet-4-5,Codex:gpt-5'" >&2
            echo "  Unset it to use the current session's model." >&2
            exit 1
        fi
        trailers+="Assisted-by: $author"$'\n'
    done
    add_trailers "$trailers" || exit 1
    exit 0
fi

## Add AI-assisted attribution trailers when running inside an AI session.
## `ai-audit session assisted-by` owns session detection and
## provider/model normalization.  It may emit multiple lines for nested
## harnesses using distinct models.  Exact duplicates are ignored by git
## interpret-trailers.
if command -v ai-audit >/dev/null 2>&1; then
    assisted_by_err=$(mktemp -t ai-audit-assisted-by-XXXXXX)
    assisted_by_out=$(ai-audit session assisted-by --quiet-if-no-session 2>"$assisted_by_err")
    assisted_by_rc=$?

    if [ $assisted_by_rc -ne 0 ]; then
        if [ -n "${OPENCODE_SESSION_ID:-}${CLAUDE_SESSION_ID:-}${PI_SESSION_ID:-}${OPENCODE:-}" ]; then
            echo "commit-msg: REJECTED" >&2
            echo "  Could not resolve AI Assisted-by attribution." >&2
            sed 's/^/  /' "$assisted_by_err" >&2
            rm -f "$assisted_by_err"
            exit 1
        fi
        echo "commit-msg: warning: ai-audit session assisted-by failed; leaving message unchanged" >&2
        sed 's/^/  /' "$assisted_by_err" >&2
    elif [ -n "$assisted_by_out" ]; then
        add_trailers "$assisted_by_out" || { rm -f "$assisted_by_err"; exit 1; }
    fi
    rm -f "$assisted_by_err"
fi

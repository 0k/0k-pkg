# -*- mode: shell-script -*-
# shellcheck shell=bash
# sunit provides the DSL variables and intentionally evaluates quoted commands.
# shellcheck disable=SC2016,SC2034,SC2154

## ``git-hook/commit-msg/20-convention``: title grammar of a commit
## message.  Each case writes the message to a file and runs the
## repository copy of the hook on it, as git does.

prefix_cmd='
hook="$base/src/etc/pkgcmd.d/all/git-hook/commit-msg/20-convention"
check() { printf "%s\n" "$@" > "$test_tmpdir/msg"; "$hook" "$test_tmpdir/msg"; }
'


## Colon in the description

try 'check "new: pi-server: let vigil pick the model"' \
    "a word-colon after the type is rejected, not read as description"
is errlvl 1
is err part "[L1] TITLE-DESC"
is err part "offending: «new: pi-server: let vigil pick the model»"

try 'check "new: [identity] wire auth: accept device certificates"' \
    "a label-colon inside the description is rejected"
is errlvl 1
is err part "[L1] TITLE-DESC"

try 'check "$(cat <<'"'"'EOF'"'"'
fix: [api] quote ``mode: fast`` in the bind error
EOF
)"' \
    "a colon-space inside double backticks is accepted"
noerror

try 'check "chg: [clock] shorten entries ending at 12:30"' \
    "a colon not followed by a space is accepted"
noerror

try 'check "fix: doc: explain the release steps" "" "Why: the old steps were stale."' \
    "a known scope and a colon in the body are accepted"
noerror


## First word of the description: an imperative verb from ``verbs.txt``

try 'check "new: [git-hook] Add a verb check"' \
    "a listed verb is accepted, whatever its case"
noerror

try 'check "fix: [git-hook] added a verb check"' \
    "a past tense is rejected and the base verb is suggested"
is errlvl 1
is err part "[L1] TITLE-VERB: description must start with an imperative verb; \`added\` is a form of \`add\`: write \`add\`"

try 'check "chg: [git-hook] using the new verb list"' \
    "a present participle is rejected and the base verb is suggested"
is errlvl 1
is err part "\`using\` is a form of \`use\`: write \`use\`"

try 'check "chg: new verb check"' \
    "a word that is not a verb is rejected and the title must be rewritten"
is errlvl 1
is err part "[L1] TITLE-VERB: description must start with an imperative verb; \`new\` is not a verb: start the title with the action it performs"

try 'check "chg: [report] juxtapose the two timelines"' \
    "a genuine unlisted base verb is rejected with the instruction to list it"
is errlvl 1
is err part "[L1] TITLE-VERB: description must start with an imperative verb; \`juxtapose\` is a base-form verb missing from"
is err part "commit-msg/verbs.txt"
is err part "5. If TITLE-VERB says a base-form verb is missing from"
is err part "ask the user via the MCP \`Question\` tool whether to add it"
is err part "Do not swap it for a weaker listed verb, and do not bypass the hook."

try 'check "$(cat <<'"'"'EOF'"'"'
fix: ``pkg`` now lists verbs
EOF
)"' \
    "a description starting with a technical term is rejected"
is errlvl 1
is err part "[L1] TITLE-VERB"

try 'check "chg: [git-hook] normalise and colour the verb list"' \
    "British spellings are accepted"
noerror


## Title separated from the body

try 'check "fix: [api] reject empty tokens" "The parser accepted them."' \
    "a body line directly after the title is rejected"
is errlvl 1
is err part "[L2] TITLE-BODY-SEP"
is err part "offending: «The parser accepted them.»"

try 'check "fix: [api] reject empty tokens" "" "The parser accepted them."' \
    "a blank line between title and body is accepted"
noerror

try 'check "fixup! added a verb check"' \
    "autosquash titles are not audited"
noerror

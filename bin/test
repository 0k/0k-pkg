#!/bin/bash

exname="$(basename "$0")"

base=$(cd "$(dirname "$0")/.." && pwd)

if ! [ -d "$base/src" ]; then
    echo "Please execute from project directory or use 'bin/$exname'." >&2
    exit 1
fi
export base

cd "$base/test" || exit 1

sunit "$@" || exit $?

if [ "$#" -eq 0 ] || [ "$1" = announce ]; then
    exec env PYTHONDONTWRITEBYTECODE=1 \
        python3 -m unittest discover -s ../test-python -p 'test_*.py'
fi
